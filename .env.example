DATABASE_URL=sqlite:///
APPLICATION_NAME=script/sqla-raw
QUERY_PATH=query_files

# Snowflake keypair authentication.
#
# Supply the private key EITHER as a file path OR as the key itself, not both.
# Setting both is a configuration error waiting to happen: PRIVATE_KEY_PATH
# wins and PRIVATE_KEY is silently ignored, so if the two keys differ, the
# passphrase below matches only one of them and you get a confusing failure.
# Pick one and leave the other unset.
PRIVATE_KEY_PATH=rsa_key.p8
# PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Omit entirely if the key is not encrypted.
PRIVATE_KEY_PASSPHRASE=super-groovy-big-secret
